*.pem
*.key
credentials.json
secrets.json


# ============================================================
# Data
# ============================================================

# Raw data must not be versioned
data/raw/*

# Generated / transformed datasets
data/processed/*

# Keep directories in Git
!data/raw/.gitkeep
!data/processed/.gitkeep


# ============================================================
# Machine Learning models / artifacts
# ============================================================

models/*
artifacts/*

*.pkl
*.pickle
*.joblib
*.onnx

# Keep directories
!models/.gitkeep
!artifacts/.gitkeep


# ============================================================
# Experiment tracking
# ============================================================

mlruns/
wandb/


